<div class="px-4 py-5 bg-white space-y-6 sm:p-6">
  <div class="mb-6">
    <a href="/auth/google" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
      <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
        <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
        <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
      </svg>
      Sign in with Google
    </a>
  </div>
  
  <div class="relative">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-gray-300"></div>
    </div>
    <div class="relative flex justify-center text-sm">
      <span class="px-2 bg-white text-gray-500">Or continue with email</span>
    </div>
  </div>

  <.form :let={f} method="post" action={@callback_url}>
    <input type="hidden" name="redirect_url" value={Plug.Conn.get_req_header(@conn, "referer") |> List.first() || "/admin"} />
    <div class="grid grid-cols-6 gap-6">
      <div class="col-span-6 sm:col-span-3">
        <label for="email">
          Email
        </label>
        <div class="mt-1">
          <input type="email" name="email" value={@conn.params["email"]} />
        </div>
      </div>

      <div class="col-span-6 sm:col-span-3">
        <label for="password">
          Password
        </label>
        <div class="mt-1">
          <input type="password" name="password" />
        </div>
      </div>

      <div class="col-span-6 sm:col-span-3">
        <label for="code">
          2FA code <%= if Mix.env() == :dev, do: "(optional in dev)", else: "" %>
        </label>
        <div class="mt-1">
          <input type="text" name="code" placeholder={if Mix.env() == :dev, do: "Any value works", else: ""} />
        </div>
      </div>

      <div class="col-span-6 sm:col-span-3">
        <button class="btn">Login</button>
      </div>
    </div>
  </.form>
</div>
